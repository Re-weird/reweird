NEXT_PUBLIC_API_URL=http://localhost:8080
API_PORT=8080
API_HOST=127.0.0.1
# Optional direct-API bearer credential (32+ characters). Never use a NEXT_PUBLIC_ variable for it.
REWEIRD_API_TOKEN=
# Only for a private container network with host ports published to 127.0.0.1.
API_TRUSTED_NETWORK=false
DATABASE_PATH=./reweird.db
UPLOAD_DIR=./data/uploads
TELEMETRY_MODE=simulator
PROJECT_PROFILE_ID=ultrasonic-demo
SERIAL_PORT=COM5
SERIAL_BAUD=115200
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PROBE_SERVICE_URL=http://127.0.0.1:8091
PROBE_AI_PROVIDER=
GEMINI_TIMEOUT_SECONDS=10

# Google sign-in via NextAuth (apps/web). Optional: the landing page, Demo
# Mode, and the whole /app workspace all work with these unset — "Continue
# with Google" just falls back to a plain link until they're configured.
# Create an OAuth client at console.cloud.google.com > APIs & Services >
# Credentials, add http://localhost:3000/api/auth/callback/google as an
# authorized redirect URI, then copy the client id/secret below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Same value as GOOGLE_CLIENT_ID above - exposed to the browser only to let
# the UI know Google sign-in is configured, mirroring GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NextAuth's own session cookie secret. Generate with: openssl rand -base64 33
AUTH_SECRET=
# Shared with apps/api's AUTH_TOKEN_SECRET below - verifies the short-lived
# bearer token apps/web mints for API calls. Generate with: openssl rand -base64 33
AUTH_TOKEN_SECRET=
# PATCH result recording stays disabled until both are configured.
PROBE_REPORTER_ID=
PROBE_REPORTER_TOKEN=
