NEXT_PUBLIC_API_URL=http://localhost:8080
API_PORT=8080
API_HOST=127.0.0.1
# Optional direct-API bearer credential (32+ characters). Never use a NEXT_PUBLIC_ variable for it.
REWEIRD_API_TOKEN=
# Only for a private container network with host ports published to 127.0.0.1.
API_TRUSTED_NETWORK=false
DATABASE_PATH=./reweird.db
UPLOAD_DIR=./data/uploads
TELEMETRY_MODE=simulator
PROJECT_PROFILE_ID=ultrasonic-demo
SERIAL_PORT=COM5
SERIAL_BAUD=115200
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PROBE_SERVICE_URL=http://127.0.0.1:8091
PROBE_AI_PROVIDER=
GEMINI_TIMEOUT_SECONDS=10

# Google sign-in via NextAuth (apps/web). Optional: the landing page, Demo
# Mode, and the whole /app workspace all work with these unset — "Continue
# with Google" just falls back to a plain link until they're configured.
# Create an OAuth client at console.cloud.google.com > APIs & Services >
# Credentials, add http://localhost:3000/api/auth/callback/google as an
# authorized redirect URI, then copy the client id/secret below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Same value as GOOGLE_CLIENT_ID above - exposed to the browser only to let
# the UI know Google sign-in is configured, mirroring GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NextAuth's own session cookie secret. Generate with: openssl rand -base64 33
AUTH_SECRET=
# Shared with apps/api's AUTH_TOKEN_SECRET below - verifies the short-lived
# bearer token apps/web mints for API calls. Generate with: openssl rand -base64 33
AUTH_TOKEN_SECRET=
# PATCH result recording stays disabled until both are configured.
PROBE_REPORTER_ID=
PROBE_REPORTER_TOKEN=

# GitHub App (apps/api). Optional: without it, Settings shows GitHub as not
# set up and new projects can't be created from a repo. Setup steps are in
# docs/github-app.md. Leave all of these empty, or fill in all of them.
GITHUB_APP_ID=
# The App's URL name, from github.com/apps/<slug>.
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Path to the downloaded .pem, or the PEM itself (literal \n line breaks are fine).
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Seconds between checks of linked repos for new commits (min 15). Covers
# servers GitHub's webhooks can't reach, such as localhost. 0 disables it.
GITHUB_POLL_SECONDS=60

# MongoDB Atlas: persistent accounts + owner-scoped Equipment registry
# (apps/api/internal/productdata). Optional: unset, the rest of the API
# (SQLite diagnostics, Demo Mode, the simulator) works exactly as before,
# and /api/v1/me and /api/v1/equipment* return 503 PRODUCT_DATA_UNAVAILABLE.
# Never commit a real connection string here.
MONGODB_URI=
MONGODB_DATABASE=reweird

# Local-only computer diagnostics collector (apps/api/internal/computer).
# Optional: unset, real collection stays locked and only the simulator
# scenarios are available.
COMPUTER_DIAGNOSTICS_ENABLED=false

# Caps how many rows internal/store keeps in measurement_windows before
# trimming. Optional: unset or out of the 100-1,000,000 range falls back to
# 50000.
MAX_MEASUREMENT_WINDOWS=50000

# Git sync for generated diagnostic reports (apps/api/internal/gitsync,
# /api/v1/git/*). Optional: unset, git status/preview/commit endpoints
# report git sync as disabled and commits are blocked.
REWEIRD_GIT_SYNC_ENABLED=false
# Path to a local git repository the report commit is written into. Required
# for REWEIRD_GIT_SYNC_ENABLED=true.
REWEIRD_GIT_REPO=
# Commit a generated report automatically once one is built.
REWEIRD_AUTO_COMMIT_REPORTS=false
# Push the auto-commit above to its remote. Has no effect without
# REWEIRD_AUTO_COMMIT_REPORTS=true.
REWEIRD_AUTO_PUSH_REPORTS=false
