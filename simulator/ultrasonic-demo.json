{
  "project": "Ultrasonic Distance Sensor",
  "controller": "ESP32",
  "telemetry_schema_version": 2,
  "profile_id": "ultrasonic-demo",
  "probes": {
    "P1": { "role": "POWER", "healthy_value": 5.01, "unit": "V" },
    "P2": { "role": "TRIG", "healthy_value": 40.0, "unit": "kHz" },
    "P3": { "role": "ECHO", "healthy_value": 28.4, "unit": "pulses/s" }
  },
  "scenarios": [
    "healthy",
    "dead-signal",
    "low-voltage",
    "unstable-power",
    "missing-pulses",
    "intermittent-connection",
    "simultaneous-dropouts",
    "timing-drift",
    "software-controlled-change"
  ]
}
