PROBE_AI_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=10

# Both values are required before /patch-proposals/{id}/result accepts a
# human-reported action. Keep the token server-side; use 32+ random characters.
PROBE_REPORTER_ID=
PROBE_REPORTER_TOKEN=

# Milestone 7: diagnostic history persistence. Safe defaults below require
# no external service, no credentials, and no network access to run tests
# or start the service.
DIAGNOSTIC_REPOSITORY=memory
# MONGODB_URI=
# MONGODB_DATABASE=reweird_probe

TELEMETRY_SINK=none
# TIGER_DATABASE_URL=

ANALYTICS_SINK=none
