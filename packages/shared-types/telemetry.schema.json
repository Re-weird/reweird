{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reweird.local/schemas/telemetry-v2.json",
  "title": "ReWeird Telemetry Envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "device_id", "profile_id", "captured_at_ms", "uptime_ms", "window_ms", "sequence", "samples"],
  "properties": {
    "schema_version": { "const": 2 },
    "device_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,63}$" },
    "profile_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "captured_at_ms": { "type": "integer", "minimum": 0 },
    "uptime_ms": { "type": "integer", "minimum": 0 },
    "window_ms": { "type": "integer", "minimum": 10, "maximum": 60000 },
    "sequence": { "type": "integer", "minimum": 0 },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/sample" }
    }
  },
  "$defs": {
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe", "mode"],
      "properties": {
        "probe": { "type": "string", "pattern": "^P[1-6]$" },
        "mode": { "enum": ["analog", "digital", "pulse"] },
        "analog_mv": { "type": "array", "maxItems": 256, "items": { "type": "number", "minimum": 0, "maximum": 3300 } },
        "state": { "enum": [0, 1] },
        "edge_count": { "type": "integer", "minimum": 0 },
        "rising_edges": { "type": "integer", "minimum": 0 },
        "falling_edges": { "type": "integer", "minimum": 0 },
        "periods_us": { "type": "array", "maxItems": 512, "items": { "type": "number", "minimum": 0 } },
        "high_pulse_widths_us": { "type": "array", "maxItems": 512, "items": { "type": "number", "minimum": 0 } },
        "max_gap_us": { "type": "integer", "minimum": 0 },
        "activity_counts": { "type": "array", "maxItems": 120, "items": { "type": "number", "minimum": 0 } }
      }
    }
  }
}
