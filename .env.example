NEXT_PUBLIC_API_URL=http://localhost:8080
API_PORT=8080
API_HOST=127.0.0.1
# Optional direct-API bearer credential (32+ characters). Never use a NEXT_PUBLIC_ variable for it.
REWEIRD_API_TOKEN=
# Only for a private container network with host ports published to 127.0.0.1.
API_TRUSTED_NETWORK=false
DATABASE_PATH=./reweird.db
UPLOAD_DIR=./data/uploads
TELEMETRY_MODE=simulator
PROJECT_PROFILE_ID=ultrasonic-demo
SERIAL_PORT=COM5
SERIAL_BAUD=115200
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PROBE_SERVICE_URL=http://127.0.0.1:8091
PROBE_AI_PROVIDER=fake
GEMINI_TIMEOUT_SECONDS=10
# PATCH result recording stays disabled until both are configured.
PROBE_REPORTER_ID=
PROBE_REPORTER_TOKEN=
