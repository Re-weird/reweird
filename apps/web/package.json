{
  "name": "@reweird/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "postbuild": "mkdir -p .next/standalone/apps/web/.next && cp -r public .next/standalone/apps/web/public && cp -r .next/static .next/standalone/apps/web/.next/static",
    "start": "node .next/standalone/apps/web/server.js",
    "test:circuit-map": "node --test lib/circuit-map.test.mjs",
    "test:experience": "node --test lib/circuit-map.test.mjs lib/weird-demo.test.mjs lib/judge-demo.test.mjs lib/calibration.test.mjs lib/project-input.test.mjs lib/workbench.test.mjs lib/patch.test.mjs",
    "test:judge-demo": "node --test lib/judge-demo.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@reweird/shared-types": "*",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.4",
    "gsap": "^3.15.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.32",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.3"
  }
}
